# ArcTrace environment — copy to .env (never commit .env)

# 1) Main funded wallet PRIVATE key. Writes every ArcTrace entity.
#    Works with or without the 0x prefix.
ARKIV_PRIVATE_KEY=

# 2) Auditor ADDRESS only (no private key). Receives ownership in transfer tests. Optional.
ARKIV_AUDITOR=

# 3) Second funded wallet PRIVATE key: "attacker" for the planted-record test. Optional.
ARKIV_ATTACKER_KEY=

# Arkiv Tiramisu testnet RPC (default shown).
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Ledger mode: auto | mock | arkiv
LEDGER_MODE=mock

# Phase 2 local web stack (use LEDGER_MODE=mock for a wallet-free demo)
DATABASE_URL=postgres://arctrace:arctrace@localhost:5432/arctrace
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arctrace
S3_ACCESS_KEY=arctrace
S3_SECRET_KEY=arctrace123
# To use Cloudflare R2 instead, pre-create the bucket and set:
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=<your-bucket>
# S3_ACCESS_KEY=<R2 access key id>
# S3_SECRET_KEY=<R2 secret access key>
# ARCTRACE_S3_PROXY_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
SESSION_SECRET=arctrace-dev-session-secret-change-me
ALLOWED_ORIGINS=http://localhost:3000
PORT=3001
AUTO_MIGRATE=true

# Set to 1 to enable real-Arkiv contract tests.
ARKIV_E2E=
