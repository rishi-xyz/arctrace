# ArcTrace environment (copy to .env — never commit .env)

# Wallet private key for Arkiv writes (hex, 0x-prefixed).
# Create one with `pnpm gen:wallet`, then fund it at
# https://hub.arkiv.network/faucet (browser + CAPTCHA required).
# Leave empty to run in mock-ledger mode (the default).
ARKIV_PRIVATE_KEY=

# Arkiv Tiramisu testnet RPC (optional — this is the default).
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Optional auditor address for sealed/expiry experiments.
ARKIV_AUDITOR=

# auto (default: Arkiv if funded/reachable, else mock with a warning),
# mock (explicit local ledger), arkiv (fail closed if unreachable).
LEDGER_MODE=auto

# Set to 1 to run the contract test suite against real Arkiv.
ARKIV_E2E=

# Master secret for deriving per-document watermark keys in the PoC.
# Production deployments must supply this out of band.
ARCTRACE_WM_MASTER=arctrace-demo-wm-master-v1
