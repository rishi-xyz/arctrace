# ArcTrace environment — copy to .env (never commit .env)

# 1) Main funded wallet PRIVATE key. Writes every ArcTrace entity.
#    Works with or without the 0x prefix.
ARKIV_PRIVATE_KEY=

# 2) Auditor ADDRESS only (no private key). Receives ownership in transfer tests. Optional.
ARKIV_AUDITOR=

# 3) Second funded wallet PRIVATE key: "attacker" for the planted-record test. Optional.
ARKIV_ATTACKER_KEY=

# Arkiv Tiramisu testnet RPC (default shown).
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Ledger mode: auto | mock | arkiv
LEDGER_MODE=auto

# Set to 1 to enable real-Arkiv contract tests.
ARKIV_E2E=
